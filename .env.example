# ── Panel administrativo (obligatorio en producción) ─────────────────────
# Contraseña del panel /admin. Usa una frase larga.
ADMIN_PASSWORD=
# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Almacenamiento ────────────────────────────────────────────────────────
# Sin variables de Supabase se usa el modo local (data/menu.json + data/uploads),
# válido para desarrollo o servidores con disco persistente.
# DATA_DRIVER=file | supabase

# Supabase (producción serverless). Ver supabase/schema.sql
SUPABASE_URL=
# Solo servidor. NUNCA la publiques ni la uses con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Clave publicable/anon (es pública por diseño; se usa para subir archivos con URL firmada).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_BUCKET=menu-assets
MENU_ID=default

# URL pública del sitio (SEO, sitemap). También se puede definir en /admin/ajustes.
NEXT_PUBLIC_SITE_URL=
